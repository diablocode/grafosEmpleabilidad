<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:emp="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad">
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad/1.0.0"/>
    <rdfs:comment xml:lang="es">Vocabulario para representar perfiles profesionales, ofertas laborales y recomendaciones de empleabilidad.</rdfs:comment>
    <rdfs:label xml:lang="es">Ontología de empleabilidad</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Lenguaje">
    <rdfs:comment xml:lang="es">Idioma que domina o requiere un nivel explícito.</rdfs:comment>
    <rdfs:label xml:lang="es">Lenguaje</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#TrayectoriaLaboral">
    <rdfs:comment xml:lang="es">Secuencia o agrupación de etapas profesionales de un candidato.</rdfs:comment>
    <rdfs:label xml:lang="es">Trayectoria laboral</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato">
    <rdfs:comment xml:lang="es">Persona cuyo perfil profesional se representa.</rdfs:comment>
    <rdfs:label xml:lang="es">Candidato</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Habilidad">
    <rdfs:comment xml:lang="es">Capacidad práctica o técnica que puede relacionarse con una competencia.</rdfs:comment>
    <rdfs:label xml:lang="es">Habilidad</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Explicacion">
    <rdfs:comment xml:lang="es">Justificación trazable de una recomendación, con evidencia y método cuando estén disponibles.</rdfs:comment>
    <rdfs:label xml:lang="es">Explicación</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#EtapaEnTrayectoriaLaboral">
    <rdfs:comment xml:lang="es">Etapa que ordena y contextualiza un periodo de la trayectoria.</rdfs:comment>
    <rdfs:label xml:lang="es">Etapa en trayectoria laboral</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#PerfilSocioemocional">
    <rdfs:comment xml:lang="es">Conjunto opcional y contextualizado de evaluaciones socioemocionales; no representa atributos protegidos.</rdfs:comment>
    <rdfs:label xml:lang="es">Perfil socioemocional</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Empleador">
    <rdfs:comment xml:lang="es">Organización o entidad que publica o gestiona una oferta laboral.</rdfs:comment>
    <rdfs:label xml:lang="es">Empleador</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Educacion">
    <rdfs:comment xml:lang="es">Formación académica o profesional de un candidato.</rdfs:comment>
    <rdfs:label xml:lang="es">Educación</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RankingDeCompetencia">
    <rdfs:comment xml:lang="es">Evaluación ordinal o puntuación de una competencia, con escala y procedencia.</rdfs:comment>
    <rdfs:label xml:lang="es">Ranking de competencia</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RequerimientoDeCompetencia">
    <rdfs:comment xml:lang="es">Requisito de competencia asociado a una oferta laboral.</rdfs:comment>
    <rdfs:label xml:lang="es">Requerimiento de competencia</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#OfertaLaboral">
    <rdfs:comment xml:lang="es">Vacante publicada con ubicación, fechas, modalidad y condiciones disponibles.</rdfs:comment>
    <rdfs:label xml:lang="es">Oferta laboral</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#FactorSocioemocional">
    <rdfs:comment xml:lang="es">Factor evaluado dentro de un perfil socioemocional.</rdfs:comment>
    <rdfs:label xml:lang="es">Factor socioemocional</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#HabilidadSuave">
    <rdfs:comment xml:lang="es">Capacidad no técnica relevante para el desempeño profesional.</rdfs:comment>
    <rdfs:label xml:lang="es">Habilidad suave</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RedSocial">
    <rdfs:comment xml:lang="es">Persona o grupo de contacto profesional conocido por el candidato, no una plataforma electrónica.</rdfs:comment>
    <rdfs:label xml:lang="es">Red social profesional</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Recomendacion">
    <rdfs:comment xml:lang="es">Resultado que sugiere una oferta, candidato, acción u oportunidad.</rdfs:comment>
    <rdfs:label xml:lang="es">Recomendación</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#ExperienciaLaboral">
    <rdfs:comment xml:lang="es">Relación o periodo de trabajo con funciones y fechas asociadas.</rdfs:comment>
    <rdfs:label xml:lang="es">Experiencia laboral</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Competencia">
    <rdfs:comment xml:lang="es">Capacidad o dominio requerido o atribuido a un candidato.</rdfs:comment>
    <rdfs:label xml:lang="es">Competencia</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RecursoSocial">
    <rdfs:comment xml:lang="es">Recurso de empleabilidad o habilidad suave accesible mediante una conexión profesional.</rdfs:comment>
    <rdfs:label xml:lang="es">Recurso social</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#especificaCompetencia">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Competencia"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RequerimientoDeCompetencia"/>
    <rdfs:comment xml:lang="es">Indica la competencia descrita por un requerimiento.</rdfs:comment>
    <rdfs:label xml:lang="es">especifica competencia</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#conoceA">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RedSocial"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con una persona o grupo de contacto profesional.</rdfs:comment>
    <rdfs:label xml:lang="es">conoce a</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#dominaLenguaje">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Lenguaje"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con un idioma que domina en el nivel indicado.</rdfs:comment>
    <rdfs:label xml:lang="es">domina lenguaje</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneFactorSocioemocional">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#FactorSocioemocional"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#PerfilSocioemocional"/>
    <rdfs:comment xml:lang="es">Relaciona un perfil socioemocional con un factor evaluado.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene factor socioemocional</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#poseeCompetencia">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Competencia"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con una competencia declarada o evaluada.</rdfs:comment>
    <rdfs:label xml:lang="es">posee competencia</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#contieneEtapa">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#EtapaEnTrayectoriaLaboral"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#TrayectoriaLaboral"/>
    <rdfs:comment xml:lang="es">Relaciona una trayectoria laboral con una de sus etapas.</rdfs:comment>
    <rdfs:label xml:lang="es">contiene etapa</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#facilitaRecursoSocial">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RecursoSocial"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RedSocial"/>
    <rdfs:comment xml:lang="es">Relaciona un contacto profesional con un recurso de empleabilidad accesible mediante esa conexión.</rdfs:comment>
    <rdfs:label xml:lang="es">facilita recurso social</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#requiereCompetencia">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RequerimientoDeCompetencia"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#OfertaLaboral"/>
    <rdfs:comment xml:lang="es">Vincula una oferta laboral con uno de sus requerimientos de competencia.</rdfs:comment>
    <rdfs:label xml:lang="es">requiere competencia</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#recomiendaOferta">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#OfertaLaboral"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Recomendacion"/>
    <rdfs:comment xml:lang="es">Indica la oferta laboral sugerida por una recomendación.</rdfs:comment>
    <rdfs:label xml:lang="es">recomienda oferta</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneExperienciaLaboral">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#ExperienciaLaboral"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con una experiencia laboral registrada.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene experiencia laboral</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneHabilidadSuave">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#HabilidadSuave"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con una habilidad no técnica.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene habilidad suave</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#publicadoPor">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Empleador"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#OfertaLaboral"/>
    <rdfs:comment xml:lang="es">Indica la organización o entidad que publica o gestiona una oferta.</rdfs:comment>
    <rdfs:label xml:lang="es">publicado por</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#evaluaCompetencia">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Competencia"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RankingDeCompetencia"/>
    <rdfs:comment xml:lang="es">Indica qué competencia se evalúa en un ranking.</rdfs:comment>
    <rdfs:label xml:lang="es">evalúa competencia</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tipoRecomendacion">
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Recomendacion"/>
    <rdfs:comment xml:lang="es">Asigna a una recomendación un tipo controlado del catálogo SKOS de recomendaciones.</rdfs:comment>
    <rdfs:label xml:lang="es">tipo de recomendación</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#nivelMCER">
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Lenguaje"/>
    <rdfs:comment xml:lang="es">Asigna a un idioma un nivel controlado del Marco Común Europeo de Referencia para las Lenguas.</rdfs:comment>
    <rdfs:label xml:lang="es">nivel MCER</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneExplicacion">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Explicacion"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Recomendacion"/>
    <rdfs:comment xml:lang="es">Vincula una recomendación con su explicación.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene explicación</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tienePerfilSocioemocional">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#PerfilSocioemocional"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Vincula opcionalmente un candidato con su perfil socioemocional contextualizado.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene perfil socioemocional</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#recomiendaCandidato">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Recomendacion"/>
    <rdfs:comment xml:lang="es">Indica el candidato asociado al sujeto de una recomendación.</rdfs:comment>
    <rdfs:label xml:lang="es">recomienda candidato</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneEducacion">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Educacion"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con su formación académica o profesional.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene educación</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneHabilidad">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Habilidad"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con una habilidad práctica o técnica.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene habilidad</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneRanking">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#RankingDeCompetencia"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con una evaluación de competencia.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene ranking</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#utilizaEvidencia">
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Explicacion"/>
    <rdfs:comment xml:lang="es">Vincula una explicación con un recurso RDF que la respalda.</rdfs:comment>
    <rdfs:label xml:lang="es">utiliza evidencia</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#etapaDeExperiencia">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#ExperienciaLaboral"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#EtapaEnTrayectoriaLaboral"/>
    <rdfs:comment xml:lang="es">Vincula una etapa de trayectoria con la experiencia laboral que contextualiza.</rdfs:comment>
    <rdfs:label xml:lang="es">etapa de experiencia</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#tieneTrayectoria">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#TrayectoriaLaboral"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Candidato"/>
    <rdfs:comment xml:lang="es">Relaciona un candidato con su trayectoria laboral.</rdfs:comment>
    <rdfs:label xml:lang="es">tiene trayectoria</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#etapaDeEducacion">
    <rdfs:range rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#Educacion"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#EtapaEnTrayectoriaLaboral"/>
    <rdfs:comment xml:lang="es">Vincula una etapa de trayectoria con la educación que contextualiza.</rdfs:comment>
    <rdfs:label xml:lang="es">etapa de educación</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#modalidad">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#OfertaLaboral"/>
    <rdfs:comment xml:lang="es">Modalidad de trabajo indicada en una oferta.</rdfs:comment>
    <rdfs:label xml:lang="es">modalidad</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://localhost:3030/diablocode/grafosEmpleabilidad/ontology/empleabilidad#escala">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="es">IRI de la escala usada para interpretar una puntuación o nivel.</rdfs:comment>
    <rdfs:label xml:lang="es">escala</rdfs:label>
  </owl:DatatypeProperty>
